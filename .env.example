# Configuration template. Copy this file to `.env` and fill in the values.
# NEVER put real values here: this file is versioned.
SECRET_KEY=change-me-locally
DATABASE_URL=postgresql://user:password@localhost:5432/app

cp .env.example .env          # Windows PowerShell: Copy-Item .env.example .env
# then edits .env with their real values (this .env is NOT committed)
